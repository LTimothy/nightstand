[Unit]
Description=Switch Nightstand to upstream free-sleep
After=free-sleep.service

[Service]
Type=oneshot
# The leading - keeps a copy without the script working.
ExecStartPre=-/bin/bash /usr/local/lib/nightstand/live/scripts/trim_log.sh /persistent/nightstand-logs/free-sleep-revert.log
# A tree rolled back to a release from before the rename has only the old name.
ExecStart=/bin/bash -c 'test -f /usr/local/lib/nightstand/live/scripts/switch-to-upstream.sh && exec /bin/bash /usr/local/lib/nightstand/live/scripts/switch-to-upstream.sh; exec /bin/bash /usr/local/lib/nightstand/live/scripts/revert-to-stock.sh'
# Closes the download window even when the updater was killed outright.
ExecStopPost=-/bin/bash /usr/local/lib/nightstand/live/scripts/close_update_window.sh
# Recovery runs outside this operation and both replaceable trees.
ExecStopPost=-/bin/systemctl restart --no-block free-sleep-recover-switch.service
User=root
Group=root
KillMode=process
# The longest switch, with every download, install and check at its own limit, is about an hour.
TimeoutStartSec=2h
StandardOutput=append:/persistent/nightstand-logs/free-sleep-revert.log
StandardError=append:/persistent/nightstand-logs/free-sleep-revert.log
