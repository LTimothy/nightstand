[Unit]
Description=Hardlink RAW piezo files into local archive before firmware truncates them

[Service]
Type=oneshot
ExecStart=/bin/bash /usr/local/lib/nightstand/live/scripts/archive-raw.sh
# Runs as root: hardlinks of root-owned RAW files in /persistent/ require
# either ownership or root, due to fs.protected_hardlinks=1 on this kernel.
User=root
Group=root
