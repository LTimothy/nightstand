[Unit]
Description=Restart Nightstand if it stops answering
After=free-sleep.service

[Service]
Type=oneshot
# An older release without the script makes this a no-op.
ExecStart=/bin/bash -c '[ -f /usr/local/lib/nightstand/live/scripts/health_check.sh ] || exit 0; exec /bin/bash /usr/local/lib/nightstand/live/scripts/health_check.sh'
TimeoutStartSec=2min
User=root
Group=root
