{
  "name": "server",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "dotenv -e .env.pod -- node dist/server.js",
    "build": "tsc",
    "build:pr": "tsc",
    "dev": "MODE=dev dotenv -e .env.pod -- nodemon --watch src --ext ts --exec \"node --loader ts-node/esm\" src/server.ts",
    "dev:local": "dotenv -e .env.local -- nodemon --watch src --ext ts --exec \"node --loader ts-node/esm\" src/server.ts",
    "lint": "npx eslint src/ --ext .ts,.tsx",
    "test": "node --no-warnings --experimental-test-module-mocks --import 'data:text/javascript,import { register } from \"node:module\"; import { pathToFileURL } from \"node:url\"; register(\"ts-node/esm\", pathToFileURL(\"./\"));' --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./testFileGuard.mjs --test-reporter-destination=stderr 'src/**/*.test.ts'",
    "migrate": "dotenv -e .env.pod -- npx prisma migrate deploy",
    "generate": "dotenv -e .env.pod -- npx prisma generate",
    "migrate:local": "dotenv -e .env.local -- npx prisma migrate dev --name ",
    "generate:local": "dotenv -e .env.local -- npx prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "volta": {
    "node": "24.11.0"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "binary-split": "^1.0.5",
    "bree": "^9.2.0",
    "cbor": "^9.0.0",
    "chokidar": "^4.0.0",
    "cors": "^2.8.5",
    "dotenv-cli": "^8.0.0",
    "express": "^5.1.0",
    "lodash": "^4.17.0",
    "lowdb": "^6.1.0",
    "moment-timezone": "^0.5.0",
    "node-schedule": "^2.1.0",
    "winston": "^3.17.0",
    "winston-transport": "^4.9.0",
    "ws": "^8.20.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/lodash": "^4.17.0",
    "@types/node": "^24.0.0",
    "@types/node-schedule": "^2.1.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.0",
    "prisma": "^6.4.0",
    "ts-essentials": "^10.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0"
  }
}
